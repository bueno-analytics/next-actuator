{
  "compilerOptions": {
    /* Emits CommonJS, as package.json has no "type": "module" */
    "module": "nodenext",
    "target": "es2019",

    /* Build */
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,

    /* Checks */
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,

    /* Test types */
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
